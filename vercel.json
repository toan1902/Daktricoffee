{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{templates/**,data/**,about.html}",
      "maxDuration": 15
    },
    "api/**/*.mjs": {
      "includeFiles": "data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/qr/:p",
      "destination": "/api/trace?p=:p"
    },
    {
      "source": "/truy-xuat",
      "destination": "/api/trace"
    },
    {
      "source": "/truy-xuat/:code",
      "destination": "/api/trace?code=:code"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/media?p=:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog",
      "destination": "/api/blog-index"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    }
  ],
  "headers": [
    {
      "source": "/templates/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ]
}